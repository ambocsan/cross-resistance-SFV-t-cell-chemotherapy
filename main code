# load in necessary libraries
if (!requireNamespace("BiocManager", quietly = TRUE))
  install.packages("BiocManager")

BiocManager::install("depmap", force = TRUE)

library(depmap)
library(dplyr)
library(tidyr)
library(readr)
library(ggplot2)
library(ggrepel)
library(pheatmap)

# path to dataset file
prism <- read_csv("~/Downloads/secondary-screen-dose-response-curve-parameters.csv")

# ic50 VALUES -----------
# table 1: chemotherapy drug response ic50
drug_ic50_table <- prism %>%
  select(therapy = name, cell_line = ccle_name, ic50) %>%
  select(therapy, where(~ !all(is.na(.)))) %>%
  filter(!if_all(-therapy, is.na))

cell_ids <- unique(drug_ic50_table$cell_line)

# table 2: gene rna expression values
expr_long <- depmap_TPM() %>%
  transmute(
    gene = gene_name,
    entrez_id = entrez_id,
    cell_line = cell_line,          # this is the CCLE-style name in depmap
    rna_expression = rna_expression  # log2(TPM+1)
  )

gene_expr_table <- expr_long %>%
  filter(cell_line %in% cell_ids) %>%
  select(gene, entrez_id, cell_line, rna_expression)

# table 3: temozolomide ic50 values
temozolomide_ic50_table <- drug_ic50_table %>%
  filter(tolower(therapy) == "temozolomide") %>%
  filter(!is.na(ic50), ic50 > 0) %>%
  select(cell_line, ic50)

# ranked graph from high to low (resistant to sensitive) based on ic50
rank_tbl <- temozolomide_ic50_table %>%
  filter(!is.na(ic50), ic50 > 0) %>%
  arrange(desc(ic50)) %>%
  mutate(
    rank = row_number(),
    log10_ic50 = log10(ic50)
  )

# threshold to define resistant vs sensitive cell lines
threshold_tbl <- temozolomide_ic50_table %>%
  mutate(
    group = case_when(
      ic50 >= quantile(ic50, 0.75, na.rm = TRUE) ~ "resistant",
      ic50 <= quantile(ic50, 0.25, na.rm = TRUE) ~ "sensitive",
      TRUE ~ "middle"
    )
  )

table(threshold_tbl$group)

# ranked curve (log10 IC50)
ggplot(rank_tbl, aes(x = rank, y = log10_ic50)) +
  geom_line(color = "blue", linewidth = 1) +
  geom_point(color = "red", size = 2) +
  scale_x_continuous(
    breaks = rank_tbl$rank,
    labels = rank_tbl$cell_line
  ) +
  labs(
    title = "Temozolomide IC50 Ranking Across Cell Lines",
    x = "Cell lines",
    y = "IC50 (log10 µM)"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 90, size = 6, hjust = 1)
  )

# merge ic50 and gene expression datasets
full_tmz_dataset <- gene_expr_table %>%
  inner_join(temozolomide_ic50_table, by = "cell_line")

# threshold TPM > 1
expr_threshold <- 1

filtered_data <- full_tmz_dataset %>%
  filter(rna_expression > expr_threshold)

# merging dataset 
tmz_meta <- threshold_tbl %>%
  select(cell_line, ic50, group) %>%
  filter(group != "middle") %>%
  mutate(cell_line = as.character(cell_line))

expr_tmz <- gene_expr_table %>%
  inner_join(tmz_meta, by = "cell_line") %>%
  filter(!is.na(rna_expression))

expr_filtered <- expr_tmz %>%
  filter(rna_expression > expr_threshold)

# filter by standard deviation
gene_variability <- expr_filtered %>%
  group_by(gene) %>%
  summarise(
    sd_expr = sd(rna_expression, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  filter(is.finite(sd_expr))

# ---- heatmap prep 
heat_df <- expr_filtered %>%
  select(gene, cell_line, rna_expression) %>%
  pivot_wider(
    names_from = cell_line,
    values_from = rna_expression,
    values_fill = 0
  )

# make matrix 
heat_mat <- as.data.frame(heat_df)
rownames(heat_mat) <- heat_mat$gene
heat_mat$gene <- NULL
heat_mat <- as.matrix(heat_mat)

# log transform and clean up
heat_mat <- log10(heat_mat + 1)

gene_sd <- apply(heat_mat, 1, sd, na.rm = TRUE)
heat_mat <- heat_mat[gene_sd > 0 & is.finite(gene_sd), , drop = FALSE]
heat_mat <- heat_mat[complete.cases(heat_mat), , drop = FALSE]

# scale per gene
heat_mat <- t(scale(t(heat_mat)))

# annotation (base R rownames)
anno_col <- tmz_meta %>%
  select(cell_line, group) %>%
  distinct() %>%
  filter(!is.na(cell_line), cell_line != "")

anno_col <- as.data.frame(anno_col)
rownames(anno_col) <- anno_col$cell_line
anno_col$cell_line <- NULL

anno_col <- anno_col[colnames(heat_mat), , drop = FALSE]

# order columns from most sensitive to most resistant
ordered_cells <- tmz_meta %>%
  arrange(ic50) %>%
  pull(cell_line) %>%
  as.character()

ordered_cells <- ordered_cells[ordered_cells %in% colnames(heat_mat)]
ordered_cells <- unique(ordered_cells)

heat_mat <- heat_mat[, ordered_cells, drop = FALSE]
anno_col <- anno_col[ordered_cells, , drop = FALSE]

# plot heatmap for all genes
pheatmap(
  heat_mat,
  annotation_col = anno_col,
  cluster_rows = TRUE,
  cluster_cols = FALSE,
  show_colnames = FALSE,
  show_rownames = FALSE,
  border_color = NA,
  main = "Genes correlated to Temozolomide IC50 "
)

# ec50 VALUES -----------------

# table 1: chemotherapy drug response ec50
drug_ec50_table <- prism %>%
  select(therapy = name, cell_line = ccle_name, ec50) %>%
  select(therapy, where(~!all(is.na(.)))) %>%
  filter(!if_all(-therapy, is.na)) %>%
  filter(!is.na(ec50), ec50 > 0)

cell_ids <- unique(drug_ec50_table$cell_line)

# table 2: gene rna expression values
gene_expr_table <- expr_long %>%
  filter(cell_line %in% cell_ids) %>%
  select(gene, entrez_id, cell_line, rna_expression)

# table 3: temozolomide ec50 values (one ec50 per cell line)
temozolomide_ec50_table <- drug_ec50_table %>%
  filter(tolower(therapy) == "temozolomide") %>%
  filter(!is.na(ec50), ec50 > 0) %>%
  group_by(cell_line) %>%
  summarise(
    ec50 = median(ec50, na.rm = TRUE),
    .groups = "drop"
  )

# order from high to low ec50
temozolomide_ec50_table <- temozolomide_ec50_table %>%
  arrange(desc(ec50)) %>%
  mutate(cell_line = factor(cell_line, levels = cell_line))

# creating a ranked graph from high to low (resistant to sensitive) cell lines based on ec50
rank_tbl <- temozolomide_ec50_table %>%
  filter(!is.na(ec50), ec50 > 0) %>%
  arrange(desc(ec50)) %>%
  mutate(
    rank = row_number(),
    log10_ec50 = log10(ec50)
  )

# --- define exactly: 10 resistant, 20 middle, 10 sensitive ---
n_res <- 10
n_sens <- 10
n_mid <- 20

rank_tbl <- temozolomide_ec50_table %>%
  filter(!is.na(ec50), ec50 > 0) %>%
  arrange(desc(ec50)) %>%   # high = resistant
  mutate(
    rank = row_number(),
    n_total = n(),
    log10_ec50 = log10(ec50)
  )

mid_start <- floor((nrow(rank_tbl) - n_mid) / 2) + 1
mid_end   <- mid_start + n_mid - 1

tmz_meta <- rank_tbl %>%
  mutate(
    group = case_when(
      rank <= n_res ~ "resistant",
      rank > (n_total - n_sens) ~ "sensitive",
      rank >= mid_start & rank <= mid_end ~ "middle",
      TRUE ~ NA_character_
    )
  ) %>%
  filter(!is.na(group)) %>%
  select(cell_line, ec50, group) %>%
  mutate(cell_line = as.character(cell_line))

table(tmz_meta$group)

# depmap ranked curve (log10 EC50)
ggplot(rank_tbl, aes(x = rank, y = log10_ec50)) +
  geom_line(color = "blue", linewidth = 1) +
  geom_point(color = "red", size = 2) +
  scale_x_continuous(
    breaks = rank_tbl$rank,
    labels = rank_tbl$cell_line
  ) +
  labs(
    title = "Temozolomide EC50 Ranking Across Cell Lines",
    x = "Cell lines",
    y = "EC50 (log10 µM)"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 90, size = 2, hjust = 1)
  )
  
# merge ec50 and gene expression datasets to check gene expression in temozolomide
full_tmz_dataset <- gene_expr_table %>%
  inner_join(temozolomide_ec50_table, by = "cell_line")

# filter genes by creating threshold TPM > 1
expr_threshold <- 1

# filter by expression threshold
filtered_data <- full_tmz_dataset %>%
  filter(rna_expression > expr_threshold)

expr_tmz <- gene_expr_table %>%
  inner_join(tmz_meta, by = "cell_line") %>%
  filter(!is.na(rna_expression))

expr_filtered <- expr_tmz %>%
  filter(rna_expression > expr_threshold)

# build heatmap matrix 
heat_long <- expr_filtered %>%
  select(gene, cell_line, rna_expression) %>%
  mutate(
    gene = as.character(gene),
    cell_line = as.character(cell_line),
    rna_expression = as.numeric(rna_expression)
  ) %>%
  group_by(gene, cell_line) %>%
  summarise(
    rna_expression = mean(rna_expression, na.rm = TRUE),
    .groups = "drop"
  )

heat_mat <- xtabs(rna_expression ~ gene + cell_line, data = heat_long)
heat_mat <- as.matrix(heat_mat)

# log transform and clean up data
heat_mat <- log10(heat_mat + 1)
gene_sd <- apply(heat_mat, 1, sd, na.rm = TRUE)
heat_mat <- heat_mat[
  gene_sd > 0 & is.finite(gene_sd),
  ,
  drop = FALSE
]
heat_mat <- heat_mat[complete.cases(heat_mat), , drop = FALSE]

# scale per gene
heat_mat <- t(scale(t(heat_mat)))

# annotation for heatmap columns
anno_col <- tmz_meta %>%
  select(cell_line, group) %>%
  mutate(cell_line = as.character(cell_line)) %>%
  filter(!is.na(cell_line), cell_line != "") %>%
  distinct(cell_line, .keep_all = TRUE)

anno_col <- as.data.frame(anno_col)
rownames(anno_col) <- anno_col$cell_line
anno_col$cell_line <- NULL

anno_col <- anno_col[colnames(heat_mat), , drop = FALSE]

# order columns from most sensitive to most resistant
ordered_cells <- tmz_meta %>%
  arrange(ec50) %>%
  pull(cell_line) %>%
  as.character()

ordered_cells <- ordered_cells[ordered_cells %in% colnames(heat_mat)]
ordered_cells <- unique(ordered_cells)

heat_mat <- heat_mat[, ordered_cells, drop = FALSE]
anno_col <- anno_col[ordered_cells, , drop = FALSE]

# plot heatmap for all genes
pheatmap(
  heat_mat,
  annotation_col = anno_col,
  cluster_rows = TRUE,
  cluster_cols = FALSE,
  show_colnames = FALSE,
  show_rownames = FALSE,
  border_color = NA,
  main = "Genes correlated to Temozolomide EC50"
)

# -------
# look at gene pathway interactions to try and see if there's any patterns?
# -------

# first look at top100 genes for each (ic50 and ec50)

# build ic50
tmz_meta_ic50 <- threshold_tbl %>%
  select(cell_line, ic50, group) %>%
  mutate(cell_line = as.character(cell_line))

# iC50 correlation analysis 
ic50_expr <- gene_expr_table %>%
  inner_join(tmz_meta_ic50, by = "cell_line") %>%   # restricts to chosen IC50 lines
  filter(!is.na(rna_expression), !is.na(ic50)) %>%
  mutate(
    gene = as.character(gene),
    cell_line = as.character(cell_line)
  )

ic50_stats <- ic50_expr %>%
  group_by(gene) %>%
  summarise(
    correlation = cor(rna_expression, ic50,
                      method = "spearman",
                      use = "complete.obs"),
    .groups = "drop"
  ) %>%
  filter(is.finite(correlation)) %>%
  mutate(abs_cor = abs(correlation)) %>%
  arrange(desc(abs_cor))

top100_ic50_genes <- ic50_stats %>%
  slice_head(n = 100) %>%
  pull(gene)

cat("Top 100 IC50-associated genes selected (restricted to chosen IC50 lines)\n")

# annotation bar (from tmz_meta_ic50 groups)
anno_ic50 <- tmz_meta_ic50 %>%
  select(cell_line, group) %>%
  distinct()

anno_ic50 <- as.data.frame(anno_ic50)
rownames(anno_ic50) <- anno_ic50$cell_line
anno_ic50$cell_line <- NULL

# top100 ic50 genes heatmap (ONLY chosen lines)
heat_long_ic50 <- ic50_expr %>%
  filter(gene %in% top100_ic50_genes) %>%
  select(gene, cell_line, rna_expression) %>%
  group_by(gene, cell_line) %>%
  summarise(rna_expression = mean(rna_expression, na.rm = TRUE), .groups = "drop")

heat_mat_ic50 <- xtabs(rna_expression ~ gene + cell_line,
                       data = heat_long_ic50)

heat_mat_ic50 <- as.matrix(heat_mat_ic50)

# choose your preferred column ordering (high iC50 = resistant first)
ordered_cells_ic50 <- tmz_meta_ic50 %>%
  arrange(desc(ic50)) %>%
  pull(cell_line) %>%
  as.character()

genes_keep <- intersect(top100_ic50_genes, rownames(heat_mat_ic50))
cells_keep <- intersect(ordered_cells_ic50, colnames(heat_mat_ic50))

# keep the order you intended
genes_keep <- top100_ic50_genes[top100_ic50_genes %in% genes_keep]
cells_keep <- ordered_cells_ic50[ordered_cells_ic50 %in% cells_keep]

cat("IC50 heatmap genes kept:", length(genes_keep), "of", length(top100_ic50_genes), "\n")
cat("IC50 heatmap cell lines kept:", length(cells_keep), "of", length(ordered_cells_ic50), "\n")

heat_mat_ic50 <- heat_mat_ic50[genes_keep, cells_keep, drop = FALSE]

heat_mat_ic50 <- t(scale(t(heat_mat_ic50)))
heat_mat_ic50 <- heat_mat_ic50[complete.cases(heat_mat_ic50), , drop = FALSE]

anno_ic50_sub <- anno_ic50[colnames(heat_mat_ic50), , drop = FALSE]

pheatmap(
  heat_mat_ic50,
  annotation_col = anno_ic50_sub,
  cluster_rows = TRUE,
  cluster_cols = FALSE,
  show_colnames = FALSE,
  show_rownames = TRUE,
  fontsize_row = 4,
  border_color = NA,
  main = "Top 100 correlated genes (TMZ IC50)"
)

