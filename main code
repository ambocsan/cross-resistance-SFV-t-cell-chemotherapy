  sens_mat,
  annotation_col = anno_ic50_sub,
  cluster_rows = TRUE,
  cluster_cols = TRUE,
  show_rownames = TRUE,
  show_colnames = FALSE,
  fontsize_row = 5,
  main = "TMZ sensitivity-associated genes"
)

