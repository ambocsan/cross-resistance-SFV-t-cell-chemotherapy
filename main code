# ---------- look at ic50 patterns between sensitive and resistant

# sensitivity genes: higher expression to lower IC50
sensitivity_genes <- ic50_stats %>%
  filter(correlation < 0) %>%         
  arrange(correlation) %>%             
  slice_head(n = 50) %>%
  pull(gene)

# resistance genes: higher expression to higher IC50
resistance_genes <- ic50_stats %>%
  filter(correlation > 0) %>%          
  arrange(desc(correlation)) %>%       
  slice_head(n = 50) %>%
  pull(gene)

# subset heatmap matrix
sens_mat <- heat_mat_ic50[rownames(heat_mat_ic50) %in% sensitivity_genes, ]
res_mat  <- heat_mat_ic50[rownames(heat_mat_ic50) %in% resistance_genes, ]

# heatmaps
