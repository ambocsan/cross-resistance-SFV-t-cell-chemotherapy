# z-score ec50
ec50_heat <- t(apply(ec50_mat, 1, function(x) {
  if (all(is.na(x))) return(rep(NA, length(x)))
  if (sd(x, na.rm = TRUE) == 0) return(rep(0, length(x)))
  (x - mean(x, na.rm = TRUE)) / sd(x, na.rm = TRUE)
}))

