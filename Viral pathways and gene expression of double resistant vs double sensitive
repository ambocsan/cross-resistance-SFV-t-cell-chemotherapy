# now compare the two extremes: double resistant and double sensitive
# to do this i take the cell lines across all chemotherapies
# define the groups
pathway_results_list <- list()
volcano_plots <- list()

for (drug in names(quadrant_results)) {
  
  cat("\n")
  cat("Processing:", drug, "\n")
  
  df_drug <- quadrant_results[[drug]]
  
  # High Viral / High Chemo
  viral_resistant_chemo_resistant <- df_drug %>%
    filter(quadrant == "High Viral / High Chemo") %>%
    pull(ccle_name)
  
  # Low Viral / High Chemo
  viral_sensitive_chemo_resistant <- df_drug %>%
    filter(quadrant == "Low Viral / High Chemo") %>%
    pull(ccle_name)
  
  cat("ChemoR ViralR:", length(viral_resistant_chemo_resistant), "\n")
  cat("ChemoR ViralS:", length(viral_sensitive_chemo_resistant), "\n")
  
  cells_use <- intersect(
    colnames(gsva_scores),
    c(
      viral_resistant_chemo_resistant,
      viral_sensitive_chemo_resistant
    )
  )
  
  if (length(cells_use) < 10)
    next
  
  gsva_sub <- gsva_scores[
    ,
    cells_use,
    drop = FALSE
  ]
  
  group <- ifelse(
    cells_use %in% viral_resistant_chemo_resistant,
    "Viral_Resistant",
    "Viral_Sensitive"
  )
  
  group <- factor(
    group,
    levels = c(
      "Viral_Sensitive",
      "Viral_Resistant"
    )
  )
  
  if (length(unique(group)) < 2)
    next
  
  design <- model.matrix(~group)
  
  fit <- lmFit(
    gsva_sub,
    design
  )
  
  fit <- eBayes(
    fit,
    trend = TRUE,
    robust = TRUE
  )
  
  pathway_results <- topTable(
    fit,
    coef = "groupViral_Resistant",
    number = Inf,
    adjust.method = "BH"
  )
  
  pathway_results_list[[drug]] <- pathway_results
  
  plot_df <- pathway_results %>%
    rownames_to_column("Pathway") %>%
    mutate(
      neglogFDR = -log10(adj.P.Val),
      sig = adj.P.Val < 0.05,
      direction = ifelse(
        logFC > 0,
        "ChemoR ViralR",
        "ChemoR ViralS"
      )
    )
  
  volcano_plots[[drug]] <-
    ggplot(
      plot_df,
      aes(
        x = logFC,
        y = neglogFDR
      )
    ) +
    geom_point(
      data = subset(plot_df, !sig),
      colour = "grey80",
      alpha = 0.6,
      size = 2
    ) +
    geom_point(
      data = subset(plot_df, sig),
      aes(colour = direction),
      alpha = 0.85,
      size = 2.5
    ) +
    geom_vline(
      xintercept = 0,
      linetype = "dashed"
    ) +
    geom_hline(
      yintercept = -log10(0.05),
      linetype = "dashed"
    ) +
    scale_colour_manual(
      values = c(
        "ChemoR ViralR" = "red",
        "ChemoR ViralS" = "blue"
      )
    ) +
    theme_bw() +
    labs(
      title = paste(
        drug,
        "Chemo Resistant: Viral Resistant vs Viral Sensitive"
      ),
      x = "GSVA logFC",
      y = "-log10(FDR)"
    )
  
}

