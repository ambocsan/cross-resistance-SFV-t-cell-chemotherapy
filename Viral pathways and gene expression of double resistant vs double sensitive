# load prism data
prism <- read_csv(
  "~/Downloads/secondary-screen-dose-response-curve-parameters.csv"
)

# select chemotherapies of interest
chemo_drugs <- c(
  "temozolomide",
  "topotecan",
  "etoposide",
  "busulfan",
  "doxorubicin",
  "cisplatin",
  "carboplatin",
  "vincristine"
)

chemo_df <- prism %>%
  mutate(name = tolower(name)) %>%
  filter(name %in% chemo_drugs)

# msigdb pathway c2
msig <- msigdbr(
  species = "Homo sapiens",
  collection = "C2"
)

pathways <- split(msig$gene_symbol, msig$gs_name)

# load depmap gene expression
expr_raw <- depmap_TPM()

expr_filtered <- expr_raw %>%
  select(gene_name, cell_line, rna_expression) %>%
  filter(!is.na(rna_expression))

expr_mat <- expr_filtered %>%
  group_by(gene_name, cell_line) %>%
  summarise(rna_expression = mean(rna_expression), .groups = "drop") %>%
  pivot_wider(names_from = cell_line, values_from = rna_expression, values_fill = 0)

# save it and load on future runs because it takes 10 mins.
write.csv(expr_mat, "expr_mat.csv")

# gene name and log transform
expr_mat <- as.data.frame(expr_mat)
rownames(expr_mat) <- expr_mat$gene_name
expr_mat$gene_name <- NULL

expr_mat <- as.matrix(expr_mat)
storage.mode(expr_mat) <- "numeric"
expr_mat <- log2(expr_mat + 1)

# load gene set variation analysis
param <- GSVA::gsvaParam(
  exprData = expr_mat,
  geneSets = pathways,
  kcdf = "Gaussian"
)

gsva_scores <- GSVA::gsva(param)

write.csv(gsva_scores, "gsva_scores.csv")

# create ec50 vs ic50 scatter
# this is to see if there is a correlation between the values
# then one value will be chosen for further analysis

#compare ec50 ic50 dataframes
df_compare <- chemo_df %>%
  filter(
    !is.na(ec50),
    !is.na(ic50),
    ec50 > 0,
    ic50 > 0
  ) %>%
  group_by(name, ccle_name) %>%
  summarise(
    log_ec50 = median(log10(ec50), na.rm = TRUE),
    log_ic50 = median(log10(ic50), na.rm = TRUE),
    .groups = "drop"
  )

# drug colours
drug_colors <- c(
  temozolomide = "lightpink",
  topotecan = "lightgreen",
  etoposide = "lightblue",
  busulfan = "turquoise",
  doxorubicin = "seagreen",
  cisplatin = "tan1",
  carboplatin = "plum",
  vincristine = "salmon"
)

# correlation statistics
cor_stats <- df_compare %>%
  group_by(name) %>%
  summarise(
    r = cor(log_ic50, log_ec50, use = "complete.obs", method = "pearson"),
    p = cor.test(log_ic50, log_ec50, method = "pearson")$p.value,
    x = min(log_ic50, na.rm = TRUE),
    y = max(log_ec50, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    label = paste0("r = ", round(r, 2), "\n",
                   "p = ", signif(p, 3))
  )

# plot correlation
ggplot(df_compare, aes(x = log_ic50, y = log_ec50, colour = name)) +
  geom_point(alpha = 0.6, size = 1.5) +
  geom_abline(slope = 1, intercept = 0,
              linetype = "dashed", colour = "red") +
  geom_text(
    data = cor_stats,
    aes(x = x, y = y, label = label),
    inherit.aes = FALSE,
    hjust = 0, vjust = 1,
    size = 3
  ) +
  facet_wrap(~name, ncol = 4, scales = "free") +
  scale_colour_manual(values = drug_colors) +
  theme_minimal() +
  theme(
    legend.position = "none",
    panel.border = element_rect(
      colour = "black",
      fill = NA,
      linewidth = 0.8
    ),
    plot.title = element_text(face = "bold")
  ) +
  labs(
    title = "EC50 vs IC50",
    x = "log10(IC50)",
    y = "log10(EC50)"
  )

