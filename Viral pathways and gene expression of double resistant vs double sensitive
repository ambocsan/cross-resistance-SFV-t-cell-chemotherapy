# create table
viral_score <- tibble(
  cell_line = colnames(gsva_scores),
  viral_score = colMeans(gsva_scores[immune_pathways, , drop = FALSE], na.rm = TRUE)
)

# set quadrant cutoffs
drug_cutoffs <- tibble(
  drug = chemo_drugs,
  viral_cutoff = rep(0, length(chemo_drugs)),
  chemo_cutoff = c(1, 0.5, 1.25, 0.25, 0.5, 0, 1, 0.5)
)

# plot quadrants for each drug, and combine the plots
quadrant_results <- list()
plots <- list()

for (drug in chemo_drugs) {
  
  cut <- drug_cutoffs %>% filter(drug == !!drug)
  if (nrow(cut) == 0) next
  
  x_cut <- cut$viral_cutoff
  y_cut <- cut$chemo_cutoff
  
  df_sub <- chemo_df %>%
    filter(name == drug) %>%
    filter(!is.na(ec50), ec50 > 0) %>%
    group_by(ccle_name) %>%
    summarise(
      ec50 = median(ec50),
      .groups = "drop"
    ) %>%
    mutate(
      chemo_z = as.numeric(
        scale(log10(ec50))
      )
    ) %>%
    left_join(
      viral_score,
      by = c("ccle_name" = "cell_line")
    ) %>%
    filter(!is.na(viral_score))
  
  if (nrow(df_sub) < 5) next
  
  df_sub <- df_sub %>%
    mutate(
      quadrant = case_when(
        viral_score >= x_cut & chemo_z >= y_cut ~ "High Viral / High Chemo",
        viral_score >= x_cut & chemo_z <  y_cut ~ "High Viral / Low Chemo",
        viral_score <  x_cut & chemo_z >= y_cut ~ "Low Viral / High Chemo",
        TRUE ~ "Low Viral / Low Chemo"
      )
    )
  
  quadrant_results[[drug]] <- df_sub
  
  p <- ggplot(df_sub, aes(viral_score, chemo_z)) +
    geom_point(
      color = drug_colors[[drug]],
      alpha = 0.7,
      size = 1.5
    ) +
    geom_vline(
      xintercept = x_cut,
      linetype = "dashed"
    ) +
    geom_hline(
      yintercept = y_cut,
      linetype = "dashed"
    ) +
    theme_minimal() +
    theme(
      panel.border = element_rect(
        color = "black",
        fill = NA
      ),
      legend.position = "none",
      plot.title = element_text(
        face = "bold",
        size = 10
      )
    ) +
    labs(
      title = paste0(
        drug,
        " (n=",
        nrow(df_sub),
        ")"
      ),
      x = "Viral resistance score",
      y = "Chemotherapy resistance score"
    )
  
  plots[[drug]] <- p
}

