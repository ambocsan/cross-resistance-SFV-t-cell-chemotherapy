    "Sensitive"
  ),
  levels = c(
    "Sensitive",
    "Resistant"
  )
)

table(group)

# differential gene expression
design <- model.matrix(~ group)

fit <- lmFit(
  viral_mat,
  design
)

fit <- eBayes(
  fit,
  trend = TRUE,
  robust = TRUE
)

viral_de <- topTable(
  fit,
  coef = "groupResistant",
  number = Inf,
  adjust.method = "BH"
) %>%
  rownames_to_column("Gene")

# look at significant viral genes
viral_sig <- viral_de %>%
  filter(adj.P.Val < 0.05)

cat(
  "Significant viral genes:",
  nrow(viral_sig),
  "\n"
)

# top genes for heatmap
top_genes <- viral_sig %>%
  arrange(adj.P.Val) %>%
  slice_head(n = 50) %>%
  pull(Gene)

# if fewer than 50 significant genes
if(length(top_genes) < 50){
  
  top_genes <- viral_de %>%
    arrange(adj.P.Val) %>%
    slice_head(n = min(50, nrow(viral_de))) %>%
    pull(Gene)
  
}

# heatmap matrix
heat_mat <- viral_mat[
  top_genes,
  ,
  drop = FALSE
]


# order samples
# sensitive first
# resistant second
sample_order <- c(
  sens_cells[
    sens_cells %in% colnames(heat_mat)
  ],
  res_cells[
    res_cells %in% colnames(heat_mat)
  ]
)

heat_mat <- heat_mat[
  ,
  sample_order,
  drop = FALSE
]

# z-score genes
heat_mat <- t(
  apply(
    heat_mat,
    1,
    function(x){
      
      if(
        sd(
          x,
          na.rm = TRUE
        ) == 0
      ){
        return(
          rep(
            0,
            length(x)
          )
        )
      }
      
      (
        x -
          mean(
            x,
            na.rm = TRUE
          )
      ) /
        sd(
          x,
          na.rm = TRUE
        )
      
    }
  )
)

# remove non-variable genes
heat_mat <- heat_mat[
  apply(
    heat_mat,
    1,
    sd,
    na.rm = TRUE
  ) > 0,
  ,
  drop = FALSE
]

