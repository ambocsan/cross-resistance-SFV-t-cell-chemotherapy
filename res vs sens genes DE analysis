# libraries
library(dplyr)
library(tidyr)
library(tibble)
library(limma)
library(ggplot2)
library(ggrepel)

# keep only resistant and sensitive lines
tmz_meta_de <- threshold_tbl %>%
  filter(group %in% c("resistant", "sensitive")) %>%
  mutate(cell_line = as.character(cell_line)) %>%
  distinct(cell_line, .keep_all = TRUE)

table(tmz_meta_de$group)

# restrict expression to those lines
expr_de_long <- gene_expr_table %>%
  mutate(cell_line = as.character(cell_line)) %>%
  inner_join(tmz_meta_de %>% select(cell_line, group), by = "cell_line") %>%
  filter(!is.na(rna_expression))

# filter gene expression
expr_threshold <- 1

expr_de_long <- expr_de_long %>%
  filter(rna_expression > expr_threshold)

# expression matrix
#  rows = genes & columns = cell lines
expr_de_wide <- expr_de_long %>%
  select(gene, cell_line, rna_expression) %>%
  group_by(gene, cell_line) %>%
  summarise(rna_expression = mean(rna_expression, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(
    names_from = cell_line,
    values_from = rna_expression
  )

expr_de_df <- as.data.frame(expr_de_wide)
rownames(expr_de_df) <- expr_de_df$gene
expr_de_df$gene <- NULL

expr_de_mat <- as.matrix(expr_de_df)

# remove genes with any NA
expr_de_mat <- expr_de_mat[complete.cases(expr_de_mat), , drop = FALSE]

# remove zero-variance genes
gene_sd <- apply(expr_de_mat, 1, sd, na.rm = TRUE)
expr_de_mat <- expr_de_mat[gene_sd > 0 & is.finite(gene_sd), , drop = FALSE]

dim(expr_de_mat)

# vector and matrix
group_vec <- tmz_meta_de$group
names(group_vec) <- tmz_meta_de$cell_line

# keep only shared cell lines
common_cells <- intersect(colnames(expr_de_mat), names(group_vec))

expr_de_mat <- expr_de_mat[, common_cells, drop = FALSE]
group_vec <- group_vec[common_cells]

# set factor order: sensitive first, resistant second
group_vec <- factor(group_vec, levels = c("sensitive", "resistant"))

table(group_vec)
stopifnot(all(colnames(expr_de_mat) == names(group_vec)))

# limma differential expression
design <- model.matrix(~ 0 + group_vec)
colnames(design) <- levels(group_vec)

fit <- lmFit(expr_de_mat, design)

contrast_matrix <- makeContrasts(
  resistant - sensitive,
  levels = design
)

fit2 <- contrasts.fit(fit, contrast_matrix)
fit2 <- eBayes(fit2)

de_results <- topTable(
  fit2,
  number = Inf,
  adjust.method = "fdr",
  sort.by = "P"
)

# gene annotations
gene_annot <- gene_expr_table %>%
  select(gene, entrez_id) %>%
  distinct()

de_results_annot <- de_results %>%
  rownames_to_column("gene") %>%
  left_join(gene_annot, by = "gene") %>%
  select(gene, entrez_id, everything())

head(de_results_annot)

write.csv(
  de_results_annot,
  "temozolomide_resistant_vs_sensitive_DE.csv",
  row.names = FALSE
)

#--------- plots

volcano_df <- volcano_df %>%
  mutate(
    key = case_when(
      adj.P.Val < 0.05 & logFC > 0 ~ "Up (Resistant)",
      adj.P.Val < 0.05 & logFC < 0 ~ "Down (Sensitive)",
      TRUE ~ "Not significant"
    )
  )

ggplot(volcano_df, aes(x = logFC, y = negLog10FDR, color = direction)) +
  geom_point(alpha = 0.7) +
  scale_color_manual(
    name = NULL,
    values = c(
      "Up (Resistant)" = "red",
      "Down (Sensitive)" = "blue",
      "Not significant" = "grey"
    ),
    labels = c(
      "Up (Resistant)" = "High in resistant",
      "Down (Sensitive)" = "High in sensitive",
      "Not significant" = "Not significant"
    )
  ) +
  theme_minimal()

# ranked gene list for enrichment analysis
gene_rank_t <- de_results$t
names(gene_rank_t) <- rownames(de_results)

gene_rank_t <- sort(gene_rank_t, decreasing = TRUE)

# rank by signed -log10(p)
gene_rank_signedp <- -log10(de_results$P.Value) * sign(de_results$logFC)
names(gene_rank_signedp) <- rownames(de_results)

gene_rank_signedp <- sort(gene_rank_signedp, decreasing = TRUE)

# save ranked lists
write.csv(
  data.frame(gene = names(gene_rank_t), score = gene_rank_t),
  "tmz_ranked_genes_tstat.csv",
  row.names = FALSE
)

write.csv(
  data.frame(gene = names(gene_rank_signedp), score = gene_rank_signedp),
  "tmz_ranked_genes_signedlogp.csv",
  row.names = FALSE
)
